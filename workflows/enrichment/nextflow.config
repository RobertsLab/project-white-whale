// The enrichment workflow (MeDIP, MBD-seq): the shared profiles and WHALE_*
// variables from config/base.config, plus this workflow's parameters.
includeConfig '../../config/base.config'

params {
    // Where the bowtie2 index is kept, as <dir>/bowtie2_genome. Default (null):
    // the assembly's reference bundle, next to bismark_genome.
    bowtie2_index_dir  = System.getenv('WHALE_BOWTIE2_INDEX')
    bowtie2_args       = ''
    min_mapq           = 10          // fragments counted: unique-enough alignments only
    window_size        = 1000        // the 1 kb tiles of PLAN.md §6.2
    fragment_length    = 200         // single-end reads are extended to this (MEDIPS `extend`)
    enrichment_min_cpgs = 5          // obs_exp is left empty for regions with fewer CpGs
    saturation_seed    = 1

    // QC gate. Mapping is for plain (not bisulfite) reads, so far higher than
    // Bismark's; relH > 1 means the captured fragments are CpG-richer than the
    // genome, the first sign the pull-down worked (MEDIPS.CpGenrich).
    enrichment_min_mapping   = 50.0
    enrichment_min_fragments = 1000000
    enrichment_min_relh      = 1.0
}

process {
    withName: 'BOWTIE2_BUILD'    { memory = '16 GB' }
    withName: 'ENRICHMENT_COUNT' { memory = '12 GB' }
}

profiles {
    desktop {
        process { withName: 'BOWTIE2_ALIGN' { maxForks = 1 } }
    }
    raven {
        process { withName: 'BOWTIE2_ALIGN' { maxForks = 3 } }
    }
    klone {
        process {
            withName: 'BOWTIE2_BUILD'      { cpus = 8;  memory = '32 GB' }
            withName: 'BOWTIE2_ALIGN'      { cpus = 12; memory = '24 GB' }
            withName: 'MARKDUP'            { cpus = 4;  memory = '16 GB' }
            withName: 'ENRICHMENT_COUNT'   { cpus = 2;  memory = '16 GB' }
        }
    }

    // Tiny simulated MeDIP fixtures (tests/fixtures/make_enrichment_fixtures.py)
    // on the same TEST genome as the methylation fixtures. Overrides the shared
    // test profile's study; run with -stub, or with docker for every real tool.
    test {
        params.study_id      = 'TEST2026_FIXTURE_MEDIP'
        params.chemistry     = 'medip'
        params.samplesheet   = "${projectDir}/../../tests/fixtures/samplesheet_enrichment.tsv"
        params.bowtie2_index_dir = 'results/test/bowtie2_index'   // keep tests/fixtures/ untouched
        params.swap_mates    = []
        params.publish_bams  = false
        params.fragment_length = 220
        params.enrichment_min_fragments = 500
        process {
            withName: 'BOWTIE2_BUILD'    { memory = '2 GB' }
            withName: 'ENRICHMENT_COUNT' { memory = '2 GB' }
        }
    }
}
