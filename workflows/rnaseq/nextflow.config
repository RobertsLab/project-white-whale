// The RNA-seq workflow uses the shared profiles, WHALE_* variables and study
// configs of config/base.config; what follows is only what RNA-seq adds.
includeConfig '../../config/base.config'

params {
    // Default: data/studies/<STUDY_ID>/rnaseq/samplesheet.tsv (whale fetch-rnaseq-samplesheet).
    rnaseq_samplesheet = null
    // Default: ${raw_dir}/<STUDY_ID>/rnaseq (whale fetch-fastq --manifest .../rnaseq/fastq_manifest.tsv).
    rnaseq_raw_dir     = null
    // Where the Salmon index is kept, as <dir>/salmon_index. Default (null):
    // the assembly's reference bundle, like the Bismark index.
    salmon_index_dir   = System.getenv('WHALE_SALMON_INDEX')
    salmon_decoys      = true       // whole genome as decoy (modules/rnaseq/salmon.nf)
    salmon_kmer        = 31
    salmon_index_args  = ''
    salmon_quant_args  = ''
    fastp_args         = ''
    // Single-end 3' adapter for fastp (Illumina TruSeq / NEBNext read 1); 'auto' = fastp's detection.
    se_adapter         = 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA'
    tag_seq            = false      // 3' tag libraries (QuantSeq): poly-X trimming, no length correction

    // QC gate (RNASEQ_QC). First guesses, to tune once real studies have run:
    // with the genome as decoy, reads from introns and unannotated loci are not
    // counted as mapped.
    rnaseq_min_mapping = 30.0       // % of fragments assigned to transcripts
    rnaseq_min_mapped  = 1000000    // fragments assigned to transcripts
    rnaseq_min_genes   = 1000       // genes with TPM >= 1
}

profiles {
    desktop {
        process {
            withName: 'SALMON_INDEX' { maxForks = 1 }
        }
    }
    // A decoy-aware index of the ~650 Mb genome needs ~20-30 GB while it builds.
    raven {
        process {
            withName: 'SALMON_INDEX' { cpus = 16; memory = '64 GB' }
            withName: 'SALMON_QUANT' { cpus = 12; memory = '24 GB' }
        }
    }
    klone {
        process {
            withName: 'FASTP'        { cpus = 8;  memory = '16 GB' }
            withName: 'SALMON_INDEX' { cpus = 16; memory = '64 GB' }
            withName: 'SALMON_QUANT' { cpus = 12; memory = '24 GB' }
        }
    }
    test {
        params.rnaseq_samplesheet = "${projectDir}/../../tests/fixtures/rnaseq/samplesheet.tsv"
        params.salmon_index_dir   = 'results/test/salmon_index_cache'   // keep tests/fixtures/ untouched
        params.rnaseq_min_mapped  = 1000
        params.rnaseq_min_genes   = 3
    }
}
