{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/RobertsLab/project-white-whale/schemas/status.schema.json",
  "title": "White Whale study processing status",
  "description": "data/studies/<STUDY_ID>/status.yaml on a study branch: which machine holds the study and how far it has got. Written by `whale start-study` and `whale set-status`; read by `whale claims`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_id", "accession", "stage", "profile", "machine", "claimed_by", "claimed_on", "history"],
  "properties": {
    "study_id": {"type": "string"},
    "accession": {"type": "string"},
    "part": {"type": ["string", "null"], "description": "For a study claimed in parts, e.g. 'gill' or '1of4'."},
    "stage": {"type": "string"},
    "profile": {"type": "string", "description": "Nextflow profile: a term in compute_profile.yaml."},
    "machine": {"type": "string", "description": "Host name the study is running on."},
    "claimed_by": {"type": "string"},
    "claimed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "nextflow_run": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "date", "machine"],
        "properties": {
          "stage": {"type": "string"},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "machine": {"type": "string"},
          "note": {"type": ["string", "null"]}
        }
      }
    }
  }
}
