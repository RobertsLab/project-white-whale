/*
 * White Whale :: klone run-only config for DECICOMP2025_POMS_AGE_EMSEQ
 *
 * Passed last, after the study config (docs/compute_profiles.md):
 *
 *   nextflow run workflows/methylation -c config/DECICOMP2025_POMS_AGE_EMSEQ.config \
 *       -c data/studies/DECICOMP2025_POMS_AGE_EMSEQ/klone.run.config -profile klone
 *
 * It lives under data/studies/ because a study PR may only touch that folder
 * and config/<STUDY_ID>.config (whale check-study-scope).
 *
 * Why: 60 libraries of 143-213 M pairs (median 173 M) at 2 x 150 bp --
 * 10.5 G pairs, about 3150 Gb of sequence. VALDIVIESO2025 aligned with this
 * same three-lane layout at 25.6-42.0 M pairs/h per 16-CPU task (its
 * VALDIVIESO2025-trace.tsv: coenv compute median 27.5, srlab cpu-g2-mem2x
 * 42.0, coenv cpu-g2 39.7). At those rates every library is an estimated
 * 3.4-8.3 h, so almost none fits the ckpt-all window (4 h 30 m) and
 * BISMARK_ALIGN again runs entirely on the lab's non-preemptible partitions,
 * spread over three lanes by a stable hash of the sample id. The hash puts
 * 20 libraries on each lane; at 2 tasks per lane the slowest lane (coenv
 * compute, ~3520 M pairs) finishes alignment in about 2.7 days.
 *
 * KNOWN DEVIATION, carried over from VALDIVIESO2025 (accepted there
 * 2026-11-01): maxForks caps the process at 6 tasks across all three lanes,
 * but Nextflow has no per-queue limit, so the hash can put 3 of the 6 on
 * coenv cpu-g2, past this project's 32-CPU / 200 GB convention for that
 * partition (docs/compute_profiles.md). Slurm holds compute and
 * cpu-g2-mem2x to 2 each. Drop the third lane to hold the convention
 * strictly, at about 4 days of alignment instead of 2.7.
 *
 * Everything else (FastQC, trimming, deduplication, extraction, summaries)
 * stays on ckpt-all as the profile has it.
 */

process {
    withName: 'BISMARK_ALIGN' {
        // Bismark's temporary FASTQ goes to the node's /scr, not the shared
        // (and often full) /gscratch.
        scratch  = '/scr'
        // 6 at once across the three lanes: see the deviation note above.
        maxForks = 6
        cpus     = 16
        // Longest estimate is 8.3 h; VALDIVIESO's longest real task was
        // 11.7 h against an estimate of 7.4-16.8 h.
        time     = '24h'
        // Lane 0 coenv compute, 1 srlab cpu-g2-mem2x, 2 coenv cpu-g2.
        // VALDIVIESO's peak RSS was 77 GB, inside lane 0's 90 GB.
        memory         = { [ '90 GB', '251 GB', '100 GB' ][ Math.floorMod(sample_id.hashCode(), 3) ] }
        queue          = { [ 'compute', 'cpu-g2-mem2x', 'cpu-g2' ][ Math.floorMod(sample_id.hashCode(), 3) ] }
        clusterOptions = { [ '--account=coenv', '--account=srlab', '--account=coenv' ][ Math.floorMod(sample_id.hashCode(), 3) ] }
    }
}
