/*
 * White Whale :: klone run-only config for PESTO2022_METHYLSEQ_WGBS
 *
 * Passed last, after the study config (docs/compute_profiles.md):
 *
 *   nextflow run workflows/methylation -c config/PESTO2022_METHYLSEQ_WGBS.config \
 *       -c data/studies/PESTO2022_METHYLSEQ_WGBS/klone.run.config -profile klone
 *
 * It lives under data/studies/ because a study PR may only touch that folder
 * and config/<STUDY_ID>.config (whale check-study-scope).
 *
 * Why: 48 libraries of 117-325 M pairs, 2 x 75 bp. ROBERTS2022 aligned ~6 Gb
 * of sequence per hour at 24 CPUs on klone (83 M x 2 x 126 bp in 3 h 29 m),
 * so these take an estimated 2.9-8.2 h each and 20 cannot finish inside the
 * ckpt-all window (4 h 30 m). Chunked alignment is not in the workflow yet.
 *
 * So BISMARK_ALIGN for those 20 (estimate > 4.5 h, from ENA base_count) runs
 * on the lab's non-preemptible partitions with 24 h, alternating between
 * coenv compute and srlab cpu-g2-mem2x. Slurm caps each at the lab's share
 * (40 CPUs / 188 GB and 32 CPUs / 503 GB), so at 16 CPUs two run on each and
 * the rest wait in the queue. coenv cpu-g2 is not used: Slurm would allow far
 * more than the lab's 32-CPU share there. The other 28 stay on ckpt-all, and
 * move to the non-preemptible partitions only from their third attempt, after
 * two time-outs or preemptions.
 */

params {
    // Estimated > 4.5 h at 24 CPUs; ordered by estimate, longest last.
    align_off_ckpt = [
        'ERR12308506', 'ERR12308518', 'ERR10683999', 'ERR10684001', 'ERR10684008',
        'ERR10684016', 'ERR10683997', 'ERR10684002', 'ERR10684010', 'ERR10684019',
        'ERR10684003', 'ERR12308526', 'ERR10684004', 'ERR10684018', 'ERR10684014',
        'ERR10684013', 'ERR10684020', 'ERR10684009', 'ERR10684015', 'ERR10684012',
        // Timed out twice on ckpt-all in the first run (2026-10-25).
        'ERR12308510', 'ERR12308512', 'ERR12308514', 'ERR12308521', 'ERR12308524',
    ]
    // Off ckpt-all, these go to cpu-g2-mem2x whatever their hash says: it
    // aligned them in 5.0 and 5.5 h on 2026-10-27, compute takes 7-9 h.
    align_on_mem2x = ['ERR12308524', 'ERR12308526']
}

process {
    withName: 'BISMARK_ALIGN' {
        // Bismark's ~30 GB of temporary FASTQ per library goes to the node's
        // /scr, not the shared (and often full) /gscratch.
        scratch        = '/scr'
        maxForks       = 20
        // Off ckpt-all: a listed library, or any library on its third attempt.
        // Which partition: alternate by a stable hash of the sample id,
        // except params.align_on_mem2x.
        cpus           = { (sample_id in params.align_off_ckpt || task.attempt >= 3) ? 16 : 24 }
        // Off ckpt-all: the lab's whole memory share on that partition, split
        // between the two that run at once (compute 188 GB less the 8 GB head
        // job, cpu-g2-mem2x 503 GB).
        memory         = { (sample_id in params.align_off_ckpt || task.attempt >= 3) ? ((Math.floorMod(sample_id.hashCode(), 2) == 0 && !(sample_id in params.align_on_mem2x)) ? '90 GB' : '251 GB') : '64 GB' }
        time           = { (sample_id in params.align_off_ckpt || task.attempt >= 3) ? '24h' : '4h 30m' }
        queue          = { (sample_id in params.align_off_ckpt || task.attempt >= 3) ? ((Math.floorMod(sample_id.hashCode(), 2) == 0 && !(sample_id in params.align_on_mem2x)) ? 'compute' : 'cpu-g2-mem2x') : 'ckpt-all' }
        clusterOptions = { (sample_id in params.align_off_ckpt || task.attempt >= 3) ? ((Math.floorMod(sample_id.hashCode(), 2) == 0 && !(sample_id in params.align_on_mem2x)) ? '--account=coenv' : '--account=srlab') : '--account=srlab' }
    }
}
