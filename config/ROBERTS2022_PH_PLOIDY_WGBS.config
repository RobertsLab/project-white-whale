/*
 * White Whale :: run configuration for ROBERTS2022_PH_PLOIDY_WGBS (PRJNA682817)
 *
 * Claimed with `whale start-study` for profile `klone`. Run from the
 * repository root of this study's worktree:
 *
 *   nextflow run workflows/methylation -c config/ROBERTS2022_PH_PLOIDY_WGBS.config -profile klone
 *
 * Machine-specific paths come from WHALE_RAW, WHALE_REFERENCE, WHALE_METHYLOMES
 * and WHALE_WORKDIR (docs/compute_profiles.md); never write one here.
 *
 * 24 libraries of 37-83 M read pairs. Without chunked alignment each library
 * aligns in one task, which must finish inside klone's ckpt task limit
 * (4 h 30 min, set by -profile klone). 24 CPUs run 8 Bismark instances; scaled
 * from AREE's measured 20 M pairs in ~1-1.5 h at 12 CPUs on klone, the largest
 * library should take ~2.5-3.5 h. If BISMARK_ALIGN tasks hit the limit, this
 * study needs chunked alignment.
 *
 * The libraries are non-directional: read 1 is ~9% C and ~9% G in both mates
 * (FastQC of SRR13207050; a directional library has < 1% C in read 1). Run
 * curious_mestorf aligned them in directional mode and mapped 30% of pairs,
 * half of what maps (the pairs from the complementary strands cannot align
 * there). --non_directional aligns all four strands. It takes about twice as
 * long per library and runs fewer Bismark instances per task (5 CPUs each), so
 * the largest libraries will not finish inside the 4 h 30 min ckpt limit at
 * 24 CPUs: run BISMARK_ALIGN on a non-preemptible partition
 * (docs/compute_profiles.md) or on raven.
 */

params {
    study_id     = 'ROBERTS2022_PH_PLOIDY_WGBS'
    chemistry    = 'wgbs' // must match the study YAML
    samplesheet  = 'data/studies/ROBERTS2022_PH_PLOIDY_WGBS/samplesheet.tsv'
    bismark_align_args = '--score_min L,0,-0.6 --non_directional'
}

process {
    // Bismark writes ~30 GB of uncompressed temporary FASTQ per library. On
    // 2026-10-23 all 24 alignments at once filled /gscratch/scrubbed (98%
    // full, shared) and the run died with "Disk quota exceeded". So: temp
    // files on the node's own /scr, and at most 8 alignments at a time.
    withName: 'BISMARK_ALIGN' { cpus = 24; memory = '64 GB'; time = '4h 30m'; scratch = '/scr'; maxForks = 8 }
}
