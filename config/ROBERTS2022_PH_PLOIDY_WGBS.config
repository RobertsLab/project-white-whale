/*
 * White Whale :: run configuration for ROBERTS2022_PH_PLOIDY_WGBS (PRJNA682817)
 *
 * Claimed with `whale start-study` for profile `klone`. Run from the
 * repository root of this study's worktree:
 *
 *   nextflow run workflows/methylation -c config/ROBERTS2022_PH_PLOIDY_WGBS.config -profile klone
 *
 * Machine-specific paths come from WHALE_RAW, WHALE_REFERENCE, WHALE_METHYLOMES
 * and WHALE_WORKDIR (docs/compute_profiles.md); never write one here.
 *
 * 24 libraries of 37-83 M read pairs. Without chunked alignment each library
 * aligns in one task, which must finish inside klone's ckpt task limit
 * (4 h 30 min, set by -profile klone). 24 CPUs run 8 Bismark instances; scaled
 * from AREE's measured 20 M pairs in ~1-1.5 h at 12 CPUs on klone, the largest
 * library should take ~2.5-3.5 h. If BISMARK_ALIGN tasks hit the limit, this
 * study needs chunked alignment.
 */

params {
    study_id     = 'ROBERTS2022_PH_PLOIDY_WGBS'
    chemistry    = 'wgbs' // must match the study YAML
    samplesheet  = 'data/studies/ROBERTS2022_PH_PLOIDY_WGBS/samplesheet.tsv'
}

process {
    withName: 'BISMARK_ALIGN' { cpus = 24; memory = '64 GB'; time = '4h 30m' }
}
