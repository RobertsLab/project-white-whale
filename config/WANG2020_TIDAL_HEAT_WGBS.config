/*
 * White Whale :: run configuration for WANG2020_TIDAL_HEAT_WGBS (PRJNA562805)
 *
 * Claimed with `whale start-study` for profile `klone`. Run from the
 * repository root of this study's worktree:
 *
 *   nextflow run workflows/methylation -c config/WANG2020_TIDAL_HEAT_WGBS.config -profile klone
 *
 * Machine-specific paths come from WHALE_RAW, WHALE_REFERENCE, WHALE_METHYLOMES
 * and WHALE_WORKDIR (docs/compute_profiles.md); never write one here.
 *
 * 12 libraries of 66-91 M read pairs, larger than ROBERTS2022's (37-83 M),
 * whose largest alignments took ~2.5 h at 24 CPUs on klone. Each library
 * aligns in one task inside klone's 4 h 30 min ckpt limit, so it gets 30 CPUs
 * (10 Bismark instances): ~3 h expected for the largest. If BISMARK_ALIGN
 * tasks hit the limit, move it off ckpt-all (docs/compute_profiles.md).
 */

params {
    study_id     = 'WANG2020_TIDAL_HEAT_WGBS'
    chemistry    = 'wgbs' // must match the study YAML
    samplesheet  = 'data/studies/WANG2020_TIDAL_HEAT_WGBS/samplesheet.tsv'
}

process {
    // Temporary FASTQ on the node's /scr (Bismark writes ~30 GB a library;
    // /gscratch/scrubbed filled up in ROBERTS2022's first run), 6 at a time.
    withName: 'BISMARK_ALIGN' { cpus = 30; memory = '80 GB'; time = '4h 30m'; scratch = '/scr'; maxForks = 6 }
}
