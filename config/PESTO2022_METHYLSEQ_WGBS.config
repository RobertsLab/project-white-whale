    // (C 17-20%, G 2-5%); directional Bismark mapped 0.3-3.5% (run magical_hugle).
    swap_mates   = ['ERR10683997', 'ERR10683998', 'ERR10684000', 'ERR10684001', 'ERR10684005',
                    'ERR10684006', 'ERR10684007', 'ERR10684013', 'ERR10684016', 'ERR10684017',
                    'ERR10684018', 'ERR12308505', 'ERR12308506', 'ERR12308507', 'ERR12308508',
                    'ERR12308509', 'ERR12308515', 'ERR12308518', 'ERR12308520', 'ERR12308522',
                    'ERR12308523']
}

