// White Whale shared Nextflow configuration: defaults and the three compute
// profiles a study can be claimed on (registry/controlled_vocabularies/
// compute_profile.yaml). Included by workflows/<name>/nextflow.config.
//
// No path in this file, a study config or a workflow names one machine. Each
// machine sets these instead (docs/compute_profiles.md):
//
//   WHALE_RAW         directory holding <STUDY_ID>/ FASTQ folders    (default data/raw)
//   WHALE_REFERENCE   directory holding <ASSEMBLY>/ reference bundles (default data/reference)
//   WHALE_METHYLOMES  where per-sample outputs are published           (default data/methylomes)
//   WHALE_WORKDIR     Nextflow work directory on fast local disk       (default work, or per profile)
//
// Resource values are first guesses carried over from AREE's runs; tune them
// once real studies have run here.

params {
    study_id         = null
    part             = null
    chemistry        = null
    samplesheet      = null
    genome_assembly  = 'GCF_963853765.1'

    raw_dir          = System.getenv('WHALE_RAW')        ?: 'data/raw'
    reference_dir    = System.getenv('WHALE_REFERENCE')  ?: 'data/reference'
    outdir           = System.getenv('WHALE_METHYLOMES') ?: 'data/methylomes'
    publish_mode     = 'symlink'

    // Bismark: the default --score_min L,0,-0.2 badly under-maps this
    // heterozygous genome (AREE CIBNOR2021: 15.5% vs 53.9% at L,0,-0.6).
    bismark_align_args = '--score_min L,0,-0.6'
    extractor_args     = ''
    trim_args          = ''
}

process {
    cpus   = 2
    memory = '4 GB'
    time   = '4h'
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low    { cpus = 2;  memory = '4 GB';  time = '4h'  }
    withLabel: process_medium { cpus = 6;  memory = '12 GB'; time = '12h' }
    withLabel: process_high   { cpus = 10; memory = '24 GB'; time = '48h' }
}

profiles {

    // Lab desktops and workstations. One alignment at a time.
    desktop {
        workDir = System.getenv('WHALE_WORKDIR') ?: 'work'
        executor {
            name   = 'local'
            cpus   = (System.getenv('WHALE_MAX_CPUS') ?: '10') as int
            memory = System.getenv('WHALE_MAX_MEMORY') ?: '28 GB'
        }
        process {
            withName: 'BISMARK_ALIGN' { maxForks = 1 }
        }
    }

    // Roberts Lab server raven (inspected 2026-10-23): Xeon Gold 5220R,
    // 24 cores / 48 threads, 247 GB RAM, Ubuntu 24.04. Shared with other lab
    // work (load ~8 when inspected), so the defaults leave headroom.
    // Containers run with the system Singularity CE 3.10 (/usr/bin, setuid):
    // Docker needs the docker group, and the /home/shared Apptainer 1.2.4
    // fails on unprivileged user namespaces. The work dir defaults to the
    // 14 TB NVMe RAID0 (/home/shared/16TB_HDD_01, despite the name): fast,
    // but no redundancy and ~1.5 TB free, so nothing kept lives there.
    raven {
        workDir = System.getenv('WHALE_WORKDIR') ?: "/home/shared/16TB_HDD_01/${System.getenv('USER')}/whale/work"
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('WHALE_SINGULARITY_CACHEDIR') ?: "/home/shared/16TB_HDD_01/${System.getenv('USER')}/whale/singularity-cache"
        executor {
            name   = 'local'
            cpus   = (System.getenv('WHALE_MAX_CPUS') ?: '36') as int
            memory = System.getenv('WHALE_MAX_MEMORY') ?: '180 GB'
        }
        process {
            withLabel: process_high   { cpus = 12; memory = '40 GB' }
            withName: 'BISMARK_ALIGN' { maxForks = 3 }
        }
    }

    // UW Hyak, checkpoint partition: preemptible, so every task is capped
    // below Hyak's ~5 h ckpt limit and retried. Run the Nextflow head job on
    // a non-preemptible partition (docs/compute_profiles.md). Apptainer is
    // enabled here; never export TMPDIR in the head job (use NXF_TEMP).
    klone {
        workDir = System.getenv('WHALE_WORKDIR') ?: "/gscratch/scrubbed/${System.getenv('USER')}/whale/work"
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.pullTimeout = '60 min'
        apptainer.cacheDir    = System.getenv('WHALE_APPTAINER_CACHEDIR') ?: "/gscratch/scrubbed/${System.getenv('USER')}/whale/apptainer-cache"
        executor {
            name            = 'slurm'
            queueSize       = 300
            submitRateLimit = '10/1sec'
            pollInterval    = '1 min'
            retry.maxAttempt = 10
            retry.delay      = '30 sec'
            retry.maxDelay   = '5 min'
            retry.reason     = 'Socket timed out|Unable to contact slurm controller|Transport endpoint|Connection'
        }
        process {
            executor       = 'slurm'
            queue          = System.getenv('WHALE_SLURM_QUEUE') ?: 'ckpt-all'
            clusterOptions = "--account=${System.getenv('WHALE_SLURM_ACCOUNT') ?: 'srlab'}"
            errorStrategy  = 'retry'
            maxRetries     = 6
            time           = '4h 45m'
            withLabel: 'process_low|process_medium|process_high' { time = '4h 45m' }
            withName: 'FASTQC'                        { cpus = 4;  memory = '8 GB'  }
            withName: 'TRIM_GALORE'                   { cpus = 8;  memory = '16 GB' }
            withName: 'BISMARK_GENOME_PREPARATION'    { cpus = 8;  memory = '32 GB' }
            withName: 'BISMARK_ALIGN'                 { cpus = 12; memory = '40 GB' }
            withName: 'BISMARK_DEDUPLICATE'           { cpus = 2;  memory = '32 GB' }
            withName: 'BISMARK_METHYLATION_EXTRACTOR' { cpus = 16; memory = '32 GB'; scratch = '/scr' }
        }
    }

    // Container engines for desktops (raven and klone enable theirs):
    // -profile desktop,docker
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }

    // CI and local smoke tests: tiny fixtures, run with -stub.
    test {
        params.study_id    = 'TEST2026_FIXTURE_WGBS'
        params.chemistry   = 'wgbs'
        params.samplesheet = "${projectDir}/../../tests/fixtures/samplesheet.tsv"
        params.raw_dir     = "${projectDir}/../../tests/fixtures/reads"
        params.reference_dir = "${projectDir}/../../tests/fixtures/reference"
        params.genome_assembly = 'TEST'
        params.outdir      = 'results/test'
        params.publish_mode = 'copy'
        executor.cpus      = 2
        executor.memory    = '4 GB'
        process.resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
    }
}

manifest {
    name            = 'white-whale'
    homePage        = 'https://github.com/RobertsLab/project-white-whale'
    description     = 'Per-sample DNA methylomes of public Crassostrea / Magallana gigas data'
    nextflowVersion = '>=24.10.0'
}
