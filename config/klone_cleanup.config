// Opt-in mid-run work-directory cleanup for disk-constrained runs (e.g. klone).
//
// Pass last on the command line when a study's intermediates would otherwise
// fill /gscratch/srlab:
//
//   nextflow run workflows/methylation -c config/<STUDY_ID>.config \
//       -c data/studies/<STUDY_ID>/klone.run.config \
//       -c config/klone_cleanup.config -profile klone
//
// nf-boost removes each completed task's output files from workDir as soon as
// every downstream task that consumes them has finished (and any publishDir
// copy has completed), while leaving .command.* logs intact. Combined with
// TRIM_GALORE's maxForks cap in config/base.config, peak workDir usage is
// bounded to the libraries currently in flight rather than the whole study.
//
// Trade-off: nf-boost cleanup does not preserve cleaned intermediates for
// -resume. If a later failure requires re-running a downstream task whose
// upstream outputs were already deleted, Nextflow will re-execute those
// upstream tasks. Kept opt-in (outside config/base.config) so default runs,
// CI, and offline environments are unaffected.

plugins {
    id 'nf-boost'
}

boost {
    cleanup         = true
    cleanupInterval = '180s'
}
