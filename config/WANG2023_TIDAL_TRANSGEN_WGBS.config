/*
 * White Whale :: run configuration for WANG2023_TIDAL_TRANSGEN_WGBS (PRJNA807732)
 *
 * Claimed with `whale start-study` for profile `raven`. Run from the
 * repository root of this study's worktree:
 *
 *   nextflow run workflows/methylation -c config/WANG2023_TIDAL_TRANSGEN_WGBS.config -profile raven
 *
 * Machine-specific paths come from WHALE_RAW, WHALE_REFERENCE, WHALE_METHYLOMES
 * and WHALE_WORKDIR (docs/compute_profiles.md); never write one here.
 */

params {
    study_id     = 'WANG2023_TIDAL_TRANSGEN_WGBS'
    chemistry    = 'wgbs' // must match the study YAML
    samplesheet  = 'data/studies/WANG2023_TIDAL_TRANSGEN_WGBS/samplesheet.tsv'

    // Every library converts at 96.3-97.6% (non-CpG methylation 2.4-3.7%), so
    // the base 98% gate failed all 24 in run sick_jang. The shortfall is
    // uniform across groups, which points to the library protocol rather than
    // bad libraries; mapping (54-60%) and CpG coverage are normal. Accepted at
    // 96% for this study only (registry limitations, item 5).
    qc_min_conversion = 96.0
}

// Study-specific resource overrides go in a `process { withName: ... }` block.
// Klone runs: also pass `-c` with a run-only config last, as described in
// docs/compute_profiles.md, so workstation time limits do not override the profile.
